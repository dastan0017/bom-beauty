# Bom Beauty environment. `pnpm dev` copies this file to the repo-root .env on first run; the values below work for
# local development as-is. Production uses infra/.env on the server (see docs/DEPLOY.md) with real secrets.
# Every app validates its variables with zod at boot.

# NODE_ENV is set by the tools (dev servers, builds, Docker images), never here.

# ── Database and queue (dev: infra/docker-compose.yml) ──────────────────
POSTGRES_USER=bom
POSTGRES_PASSWORD=bom
POSTGRES_DB=bom
# Port 5434 locally because 5432 and 5433 are often taken by other Postgres instances.
DATABASE_URL=postgresql://bom:bom@localhost:5434/bom
REDIS_URL=redis://localhost:6379

# ── API (backend) ───────────────────────────────────────────────────────
API_PORT=4000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3100
ADMIN_ORIGIN=http://localhost:5173
# Where the worker reaches the Next.js server for revalidation (prod: http://web:3000).
WEB_INTERNAL_URL=http://localhost:3100
# 32+ random characters each in production: openssl rand -hex 32
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
IP_HASH_SALT=dev-ip-hash-salt-change-me
REVALIDATE_SECRET=dev-revalidate-secret-change-me
# Dev runs BullMQ processors inside the API process; production runs a separate `--worker` container.
RUN_WORKER_IN_API=true
# Reverse proxies in front of the API (prod: 1 for Caddy, which only trusts Cloudflare). Rate limits key on the real IP.
TRUST_PROXY=0

# Object storage (dev: MinIO; prod: Hetzner Object Storage, e.g. https://fsn1.your-objectstorage.com)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bom
S3_SECRET_KEY=bom-dev-secret
S3_PUBLIC_BUCKET=bom-public
S3_PRIVATE_BUCKET=bom-private
S3_FORCE_PATH_STYLE=true
# Public base URL of processed media (prod: https://media.bombeauty.kg)
MEDIA_PUBLIC_URL=http://localhost:9000/bom-public

# Bunny Stream (videos, M5). Leave empty until the account exists.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=

# Notifications (M5). Bot token from @BotFather; chat id is set in the admin.
TELEGRAM_BOT_TOKEN=
# Dev: Mailpit catches all mail at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Bom Beauty <no-reply@bombeauty.kg>

# Optional services
SENTRY_DSN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# IndexNow (api + web): 8–128 letters, digits or dashes; the site serves it at /indexnow-key.txt
INDEXNOW_KEY=

# Seed (M1): the first owner account
SEED_OWNER_EMAIL=owner@bombeauty.kg
SEED_OWNER_PASSWORD=change-me-please
SEED_OWNER_NAME=Нурайым

# ── Site (frontend) ─────────────────────────────────────────────────────
# Server-side fetches go straight to the API on the internal network (prod: http://api:4000/v1).
INTERNAL_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/bom-public

# ── Admin ───────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/v1
VITE_SITE_URL=http://localhost:3100
# Processed media for previews (same as NEXT_PUBLIC_MEDIA_URL)
VITE_MEDIA_URL=http://localhost:9000/bom-public
