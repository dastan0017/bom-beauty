// Data model: docs/DATA-MODEL.md. Enums are mirrored in packages/shared/src/enums.ts (checked by a test).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  manager
}

enum OrderStatus {
  new
  sent
  cancelled
}

enum OrderItemType {
  product
  program
}

enum PaymentMethod {
  whatsapp
  finik
}

enum OrderPaymentStatus {
  unpaid
  pending
  paid
  refunded
}

enum PaymentStatus {
  created
  pending
  succeeded
  failed
  expired
}

enum PaymentPurpose {
  order
  check
}

enum LeadKind {
  quiz
  wholesale
}

enum MediaBucket {
  public
  private
}

enum MediaKind {
  image
  pdf
}

enum MediaStatus {
  pending
  processing
  ready
  failed
}

enum VideoStatus {
  created
  uploading
  processing
  ready
  failed
}

enum RoutinePeriod {
  am
  pm
}

// «Стандарт» is the program itself; «Мини» and «Максимум» are optional (docs/DATA-MODEL.md §3.4).
enum ProgramVariant {
  mini
  standard
  max
}

// ───────────── Users and auth ─────────────

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole  @default(manager)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]

  @@map("users")
}

model Session {
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rememberMe Boolean  @default(false) @map("remember_me")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ───────────── Catalog ─────────────

model Category {
  id       String    @id @default(uuid(7)) @db.Uuid
  slug     String    @unique
  name     String
  order    Int       @default(0)
  products Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid(7)) @db.Uuid
  slug        String    @unique
  name        String    @unique
  /// «О бренде» on every product page of the brand, above «Описание»; empty hides the block.
  description String    @default("")
  products    Product[]

  @@map("brands")
}

model Product {
  id             String           @id @default(uuid(7)) @db.Uuid
  slug           String           @unique
  name           String
  shortName      String?          @map("short_name")
  brandId        String           @map("brand_id") @db.Uuid
  brand          Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId     String           @map("category_id") @db.Uuid
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  volume         String           @default("")
  priceKgs       Int              @map("price_kgs")
  purpose        String           @default("")
  description    String           @default("")
  howToUse       String           @default("") @map("how_to_use")
  inci           String?
  badge          String?
  inStock        Boolean          @default(true) @map("in_stock")
  published      Boolean          @default(true)
  // Home page rails ("На главной странице" in the editor). isNew also shows the «Новинка» label everywhere.
  bestseller     Boolean          @default(false)
  seoulChoice    Boolean          @default(false) @map("seoul_choice")
  isNew          Boolean          @default(false) @map("is_new")
  order          Int              @default(0)
  seoTitle       String?          @map("seo_title")
  seoDescription String?          @map("seo_description")
  /// Product video (owner request 2026-10-27), played from the gallery and the catalog card.
  videoId        String?          @map("video_id") @db.Uuid
  video          Video?           @relation("ProductVideo", fields: [videoId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  programItems   ProgramItem[]
  routineSteps   ProgramStep[]
  orderLines     OrderLine[]
  /// «С этим средством ещё берут» chosen for this product, and the products that chose this one.
  related        ProductRelated[] @relation("RelatedFrom")
  relatedOf      ProductRelated[] @relation("RelatedTo")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([categoryId, published])
  @@index([brandId])
  @@map("products")
}

/// «С этим средством ещё берут» chosen by the owner (D49), in order. A product without rows gets the site's picks.
model ProductRelated {
  productId String  @map("product_id") @db.Uuid
  relatedId String  @map("related_id") @db.Uuid
  product   Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related   Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  @@id([productId, relatedId])
  @@index([relatedId])
  @@map("product_related")
}

model ProductImage {
  productId String  @map("product_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  order     Int     @default(0)
  alt       String  @default("")

  @@id([productId, mediaId])
  @@index([productId, order])
  @@map("product_images")
}

model Program {
  id              String        @id @default(uuid(7)) @db.Uuid
  slug            String        @unique
  title           String
  headline        String?
  symptom         String        @default("")
  description     String        @default("")
  course          String        @default("")
  fit             String[]
  priceKgs        Int           @map("price_kgs")
  // Optional variants: offered while the price is set and the variant has items.
  miniPriceKgs    Int?          @map("mini_price_kgs")
  maxPriceKgs     Int?          @map("max_price_kgs")
  badge           String?
  // Keys from «Подбор в тесте» (D47): the goal is a foreign key; the skin list is cleaned when a skin type is deleted.
  quizGoal        String?       @map("quiz_goal")
  goal            QuizGoal?     @relation(fields: [quizGoal], references: [key], onDelete: SetNull, onUpdate: Cascade)
  quizSkins       String[]      @map("quiz_skins")
  published       Boolean       @default(false)
  inStock         Boolean       @default(true) @map("in_stock")
  videoId         String?       @map("video_id") @db.Uuid
  video           Video?        @relation("ProgramVideo", fields: [videoId], references: [id], onDelete: SetNull)
  protocolMediaId String?       @map("protocol_media_id") @db.Uuid
  protocol        Media?        @relation("ProgramProtocol", fields: [protocolMediaId], references: [id], onDelete: SetNull)
  // 5:4 photo for the home programs grid, the catalog problem banner and order lines.
  coverMediaId    String?       @map("cover_media_id") @db.Uuid
  cover           Media?        @relation("ProgramCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  order           Int           @default(0)
  seoTitle        String?       @map("seo_title")
  seoDescription  String?       @map("seo_description")
  items           ProgramItem[]
  steps           ProgramStep[]
  orderLines      OrderLine[]
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([published, order])
  @@map("programs")
}

// The quiz's answers to «Какую главную задачу…» and «Как ведёт себя ваша кожа…», edited by the owner (D47). The design's
// rules are settings: related goals rank lower, a goal can favour skin types, a skin type can also match others and can
// keep «Максимум» away. Rules name other items by key.
model QuizGoal {
  id         String    @id @default(uuid(7)) @db.Uuid
  key        String    @unique
  name       String
  answer     String
  order      Int       @default(0)
  related    String[]
  bonusSkins String[]  @map("bonus_skins")
  programs   Program[]
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("quiz_goals")
}

model SkinType {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  answer      String
  order       Int      @default(0)
  alsoMatches String[] @map("also_matches")
  avoidMax    Boolean  @default(false) @map("avoid_max")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("skin_types")
}

model ProgramItem {
  programId String         @map("program_id") @db.Uuid
  productId String         @map("product_id") @db.Uuid
  program   Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Which variant lists the product; a product can be in several variants of one program.
  variant   ProgramVariant @default(standard)
  order     Int            @default(0)

  @@id([programId, variant, productId])
  @@index([programId, variant, order])
  @@map("program_items")
}

model ProgramStep {
  id        String        @id @default(uuid(7)) @db.Uuid
  programId String        @map("program_id") @db.Uuid
  program   Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  period    RoutinePeriod
  order     Int           @default(0)
  productId String        @map("product_id") @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  text      String

  @@index([programId, period, order])
  @@map("program_steps")
}

model Review {
  id        String   @id @default(uuid(7)) @db.Uuid
  mediaId   String   @unique @map("media_id") @db.Uuid
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  order     Int      @default(0)
  isHidden  Boolean  @default(false) @map("is_hidden")
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([isHidden, order])
  @@map("reviews")
}

// ───────────── Media and video ─────────────

model Media {
  id            String         @id @default(uuid(7)) @db.Uuid
  bucket        MediaBucket
  kind          MediaKind
  status        MediaStatus    @default(pending)
  key           String?
  mime          String?
  originalName  String?        @map("original_name")
  width         Int?
  height        Int?
  bytes         Int?
  blurDataUrl   String?        @map("blur_data_url")
  variants      Json?
  error         String?
  uploadedById  String?        @map("uploaded_by_id") @db.Uuid
  expiresAt     DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime?      @map("processed_at") @db.Timestamptz(3)
  productImages ProductImage[]
  protocolOf    Program[]      @relation("ProgramProtocol")
  coverOf       Program[]      @relation("ProgramCover")
  review        Review?

  @@index([status, expiresAt])
  @@map("media")
}

model Video {
  id           String      @id @default(uuid(7)) @db.Uuid
  provider     String      @default("bunny")
  libraryId    String      @map("library_id")
  externalId   String      @unique @map("external_id")
  status       VideoStatus @default(created)
  title        String
  originalName String?     @map("original_name")
  bytes        Int?
  durationSec  Int?        @map("duration_sec")
  width        Int?
  height       Int?
  thumbnailUrl String?     @map("thumbnail_url")
  hlsUrl       String?     @map("hls_url")
  mp4Url       String?     @map("mp4_url")
  error        String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  programs     Program[]   @relation("ProgramVideo")
  products     Product[]   @relation("ProductVideo")

  @@index([status])
  @@map("videos")
}

// ───────────── Content and settings ─────────────

model ContentBlock {
  key         String   @id
  data        Json
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("content_blocks")
}

model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("settings")
}

model Redirect {
  id         String   @id @default(uuid(7)) @db.Uuid
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  statusCode Int      @default(308) @map("status_code")
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([toPath])
  @@map("redirects")
}

// ───────────── Orders and leads ─────────────

model Order {
  id              String      @id @default(uuid(7)) @db.Uuid
  number          Int         @unique @default(autoincrement())
  status          OrderStatus @default(new)
  lines           OrderLine[]
  totalKgs        Int         @map("total_kgs")
  name            String
  phone           String
  address         String
  comment         String?
  displayCurrency String      @default("KGS") @map("display_currency")
  displayRate     Float?      @map("display_rate")
  message         String
  fromQuiz        Boolean     @default(false) @map("from_quiz")
  note            String      @default("")
  pageUrl         String?     @map("page_url")
  referrer        String?
  utm             Json?
  clientRef       String      @unique @map("client_ref")
  ipHash          String?     @map("ip_hash")
  userAgent       String?     @map("user_agent")
  statusChangedAt DateTime    @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Online payment (docs/finik/SPEC.md §0, §4). Payment state sits beside the fulfilment status above.
  paymentMethod    PaymentMethod      @default(whatsapp) @map("payment_method")
  paymentStatus    OrderPaymentStatus @default(unpaid) @map("payment_status")
  paidAt           DateTime?          @map("paid_at") @db.Timestamptz(3)
  /// The "не оплачен" Telegram message went out (sent once per online order).
  unpaidNotifiedAt DateTime?          @map("unpaid_notified_at") @db.Timestamptz(3)
  /// Secret part of the order's payment page /pay/<token>: 122 random bits, never derived from the id.
  payToken         String             @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("pay_token")
  /// Owner's correction while unpaid (delivery, discount, an added item); amount due = totalKgs + adjustmentKgs.
  adjustmentKgs    Int                @default(0) @map("adjustment_kgs")
  adjustmentNote   String?            @map("adjustment_note")
  payments         Payment[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([phone])
  @@index([paymentStatus, createdAt])
  @@map("orders")
}

/// One attempt to collect money through Finik; `id` is sent to Finik as PaymentId.
model Payment {
  id              String         @id @default(uuid(7)) @db.Uuid
  orderId         String?        @map("order_id") @db.Uuid
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// `check` = the admin's 1 сом connection test, without an order.
  purpose         PaymentPurpose @default(order)
  provider        String         @default("finik")
  /// mock | beta | prod at creation.
  environment     String
  status          PaymentStatus  @default(created)
  amountKgs       Int            @map("amount_kgs")
  /// Finik's page: a bearer link, never logged.
  paymentUrl      String?        @map("payment_url")
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  /// Short reason when Finik refused or did not answer.
  error           String?
  /// From the webhook; not unique (in production it can equal our PaymentId).
  transactionId   String?        @map("transaction_id")
  /// Webhook `id`, Finik's operation id.
  operationId     String?        @map("operation_id")
  receiptNumber   String?        @map("receipt_number")
  /// Webhook amount × 100 (1 сом = 100 тыйын).
  paidAmountTyiyn Int?           @map("paid_amount_tyiyn")
  /// qr | visa, from the webhook's service.id.
  channel         String?
  paidAt          DateTime?      @map("paid_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  events          PaymentEvent[]

  @@index([orderId, createdAt])
  @@index([status, expiresAt])
  @@map("payments")
}

/// Every verified Finik webhook, once. Whitelisted fields only, no personal data.
model PaymentEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  paymentId String?  @map("payment_id") @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  /// Webhook id, else transactionId, else sha256 of the raw body.
  dedupeKey String   @unique @map("dedupe_key")
  /// As Finik sent it, e.g. "SUCCEEDED".
  status    String
  /// applied · duplicate_payment · amount_mismatch · paid_cancelled · paid_deleted · check_paid · foreign_account · unverified_account · failed · unknown_payment · ignored
  outcome   String
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([paymentId])
  @@map("payment_events")
}

// One product or program in an order: a cart order has several product lines, a program order has one line.
model OrderLine {
  id           String          @id @default(uuid(7)) @db.Uuid
  orderId      String          @map("order_id") @db.Uuid
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position     Int             @default(0)
  type         OrderItemType
  productId    String?         @map("product_id") @db.Uuid
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  programId    String?         @map("program_id") @db.Uuid
  program      Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  title        String
  // Set when the program offered several variants at order time; null for products and single-variant programs.
  variant      ProgramVariant?
  unitPriceKgs Int             @map("unit_price_kgs")
  qty          Int
  totalKgs     Int             @map("total_kgs")

  @@index([orderId, position])
  @@index([programId])
  @@index([productId])
  @@map("order_lines")
}

model Lead {
  id          String   @id @default(uuid(7)) @db.Uuid
  kind        LeadKind
  answers     Json
  recommended String[]
  choose      Boolean  @default(false)
  message     String
  pageUrl     String?  @map("page_url")
  referrer    String?
  utm         Json?
  clientRef   String   @unique @map("client_ref")
  ipHash      String?  @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([kind, createdAt])
  @@map("leads")
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  entity    String
  entityId  String   @map("entity_id")
  action    String
  diff      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
