{
  "name": "bom-beauty",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && pnpm infra:up && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres redis s3 mailpit && docker compose -f infra/docker-compose.yml run --rm s3-init",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @bom/backend db:migrate",
    "db:seed": "pnpm --filter @bom/backend db:seed",
    "gen:api": "pnpm --filter @bom/backend gen:api",
    "e2e": "pnpm --filter @bom/frontend test:e2e && pnpm --filter @bom/admin test:e2e"
  },
  "devDependencies": {
    "@bom/config": "workspace:*",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "nestjs-zod@5.5.0": "patches/nestjs-zod@5.5.0.patch"
    }
  }
}
